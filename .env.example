# VAPID Keys for Web Push Notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:your_email@example.com"
PORT=3000

# Dashboard Authentication
DASHBOARD_PASSWORD="CHANGE_ME"

# Telegram Bot (optional — for sending campaigns via Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_AUTHORIZED_USER_ID="your_telegram_user_id_here"

# Docker Compose PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=beacon

# Redis (optional — defaults shown)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Push Configuration (optional — defaults shown)
# PUSH_BATCH_SIZE=100
# PUSH_BATCH_DELAY_MS=2000
# PUSH_TTL=10000
# PUSH_MAX_RETRIES=3
# PUSH_RETRY_BACKOFF_MS=1000